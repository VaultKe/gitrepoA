# =============================================================================
# OpenWA (WhatsApp Gateway) Configuration
# =============================================================================
# OpenWA is now the primary chat backend. The main server exposes /api/v1/wa/*
# endpoints that bridge the mobile frontend to OpenWA's REST API, WebSocket
# events, and webhooks. The legacy /chat/* and /chat-ws/* routes are preserved
# as compatibility proxies that forward to OpenWA.
#
# OPENWA_ENABLED        - Set to false to disable OpenWA integration (default: true)
# OPENWA_API_URL        - Base URL of the running OpenWA instance
# OPENWA_API_KEY        - OpenWA master API key (for server-to-server auth)
# OPENWA_WEBHOOK_SECRET - HMAC secret for validating incoming OpenWA webhooks
# OPENWA_DEFAULT_SESSION_ID - Default OpenWA session name (created if missing)
# =============================================================================

OPENWA_ENABLED=true
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_1791139818d39de75b3cbfada073a1bca43de0b27617c1cb6599939605364c52 
OPENWA_WEBHOOK_SECRET=34c5c58b9ac304df2fd6d8a066ca53ebe9d397188631a66f1d0f85fd9d843b88
OPENWA_DEFAULT_SESSION_ID=bot-new