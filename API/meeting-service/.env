# Server Configuration
SERVER_PORT=8082

# Database
DATABASE_URL=postgresql://neondb_owner:npg_raLTI8VNq4Fn@ep-small-pond-adgvxr3v.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication - MUST match main server JWT_SECRET for token sharing
JWT_SECRET=vaultke-jwt-secret-key-for-production-2024

# STUN/TURN Servers
STUN_SERVER1=stun:stun.l.google.com:19302
STUN_SERVER2=stun:stun1.l.google.com:19302
TURN_SERVERS=
TURN_CREDENTIALS=

# Room Limits
MAX_ROOM_CAPACITY=150
MAX_CONCURRENT_ROOMS=900

# Recording
ENABLE_RECORDING=true
RECORDING_STORAGE_PATH=/tmp/recordings

# TLS (optional)
TLS_CERT_FILE=
TLS_KEY_FILE=

# WebSocket Configuration
WS_PING_INTERVAL=30s
WS_PONG_TIMEOUT=10s

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ICE Configuration
MAX_ICE_CONNECTIONS=500

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8082,http://localhost:8081,http://localhost:8085,https://gitrepoa-1.onrender.com,http://gitrepoa-1.onrender.com:8082

# Redis Pub/Sub Channel for Cross-Instance Signaling
REDIS_SIGNALING_CHANNEL=vaultke-meeting-signaling
