# VaultKe Mobile API Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# Backend API URL — must be set for production builds
BACKEND_API_URL=https://gitrepoa-1.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://gitrepoa-1.onrender.com/api/v1

# Network IP for local development (used when API is on localhost)
NETWORK_IP=192.168.1.100

# Android release keystore settings (for signing production builds)
VAULTKE_STORE_FILE=vaultke-release.keystore
VAULTKE_STORE_PASSWORD=your-store-password-here
VAULTKE_KEY_ALIAS=vaultke-key
VAULTKE_KEY_PASSWORD=your-key-password-here

# Environment
NODE_ENV=production
