# ═══════════════════════════════════════════════════════════
# VaultKe Mobile — Environment Configuration
# All values in environment.js are retrieved from these vars.
# No hardcoded values — everything comes from the environment.
# ═══════════════════════════════════════════════════════════

# ── Application Environment ──
# Determines which environment config is loaded.
# Values: development | staging | production
NODE_ENV=development

# ── API Configuration ──
# Primary API base URL (highest priority)
BACKEND_API_URL=http://localhost:8085/api/v1

# Optional local network host for Expo Web when the app is served from another machine.
# Set this to your computer IP if you access the app from a different device.
# NETWORK_IP=192.168.1.100

# Fallback API URL (used if BACKEND_API_URL is not set)
# REACT_APP_API_URL=

# Expo-style public API URL (used if BACKEND_API_URL and REACT_APP_API_URL are not set)
# NEXT_PUBLIC_API_URL=

# Additional fallback API URL (used if all others are missing)
# API_BASE_URL=

# ── WebSocket ──
# WebSocket URL is derived automatically from the API base URL.
# To override, set WS_URL env var (not recommended).

# ── Request Configuration ──
REQUEST_TIMEOUT=30000
RETRY_ATTEMPTS=3

# ── Feature Flags ──
ENABLE_LOGGING=true
ENABLE_DEBUG=true
ENABLE_DEV_TOOLS=true
MOCK_PAYMENTS=false
SKIP_AUTH=false

# ── OpenWA (WhatsApp Gateway) ──
# When OPENWA_ENABLED=true the chat pages use OpenWA Socket.IO for real-time
# events instead of the backend WebSocket proxy.
# OPENWA_ENABLED=true
# OPENWA_API_URL=http://localhost:2785
# OPENWA_API_KEY=

OPENWA_ENABLED=true
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_1791139818d39de75b3cbfada073a1bca43de0b27617c1cb6599939605364c52
OPENWA_WEBHOOK_SECRET=
OPENWA_DEFAULT_SESSION_ID=default
# OPENWA_DEFAULT_SESSION_ID is used as a fallback only.
# The app will auto-resolve the actual ready session from OpenWA on connect.
OPENWA_DEFAULT_SESSION_ID=bot-new

# ── Google OAuth ──
BACKEND_PUBLIC_GOOGLE_CLIENT_ID=

# ── Firebase ──
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=

# ── Service URLs (optional) ──
# Prefix each with SERVICE_ and suffix with _URL
# Example: SERVICE_CHAT_URL=wss://chat.example.com
# SERVICE_CHAT_URL=
# SERVICE_MEETING_URL=
# SERVICE_NOTIFICATION_URL=
# SERVICE_PAYMENT_URL=
# SERVICE_FILE_URL=
# SERVICE_ANALYTICS_URL=
# SERVICE_MAP_URL=
# SERVICE_EMAIL_URL=
# SERVICE_SMS_URL=

# ── M-Pesa (optional) ──
# MPESA_CONSUMER_KEY=
# MPESA_SHORTCODE=
