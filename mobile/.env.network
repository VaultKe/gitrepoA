# Network Configuration for VaultKe Mobile App
# Copy this file to .env.local and uncomment the configuration you need

# For network access (other devices on same WiFi)
NETWORK_IP=192.168.89.51

# For tunnel access (uncomment and replace with your tunnel URL)
# TUNNEL_URL=https://your-tunnel-url.com

# The app will automatically use these environment variables
# Priority: TUNNEL_URL > NETWORK_IP > default localhost
